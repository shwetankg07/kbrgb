def die(msg):
    sys.exit(f"kbrgb: {msg}")


def find_dev():
    for p in glob.glob("/sys/class/hidraw/hidraw*"):
        try:
            if "ENEK5130" in open(p + "/device/uevent").read():
                return "/dev/" + os.path.basename(p)
        except OSError:
            pass
    return None


REACTIVE = {"typewriter", "keyflash", "wpmheat", "zen", "flow"}

# per-run tunables set from the CLI before the daemon forks
# (e.g. the WPM that maps to full red in wpmheat/flow)
FX_OPT = {}

# EVIOCGBIT(EV_KEY, 96): read the key-capability bitmap. A device that can
# emit KEY_A (code 30) is a keyboard for our purposes — this admits the AT
# keyboard, external boards and keyd/kmonad virtual devices, and rejects
# mice, power buttons and lid switches.
EVIOCGBIT_EV_KEY = 0x80604521
KEY_A = 30


def open_keyboards():
    kbs = {}
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        caps = bytearray(96)
        try:
            fcntl.ioctl(fd, EVIOCGBIT_EV_KEY, caps)
        except OSError:
            os.close(fd)
            continue
        if caps[KEY_A >> 3] >> (KEY_A & 7) & 1:
            kbs[fd] = path
        else:
            os.close(fd)
    return kbs


def drain_keys(kbs, st):
    """Non-blocking drain of pending key events into st: the kernel
    buffers between frames, we collect once per frame. Keycodes live
    only in memory — nothing is stored or logged."""
    now = time.monotonic()
    st["now"] = now
    st["new"] = []
    # pick up hotplugged keyboards (and a restarted keyd) every 5 s
    if now - st.get("rescan", 0) > 5.0:
        st["rescan"] = now
        watched = set(kbs.values())
        for fd, path in open_keyboards().items():
            if path in watched:
                os.close(fd)
            else:
                kbs[fd] = path
    if not kbs:
        return
    try:
        ready, _, _ = select.select(list(kbs), [], [], 0)
    except OSError:
        ready = []
    for fd in ready:
        while True:
            try:
                data = os.read(fd, 24 * 64)
            except BlockingIOError:
                break                              # buffer drained
            except OSError:
                os.close(fd)
                del kbs[fd]
                break
            if not data:
                break
            for off in range(0, len(data) - 23, 24):
                _, _, etype, code, value = struct.unpack_from("QQHHi", data, off)
                if etype == 1 and value == 1:      # EV_KEY press
                    st["new"].append((now, code))
            if len(data) < 24 * 64:
                break                              # short read: caught up
    if st["new"]:
        q = st.setdefault("keys", deque(maxlen=64))
        q.extend(st["new"])
        st["last_key"] = now


def open_dev():
    dev = find_dev()
    if dev is None:
        die("ENEK5130 keyboard controller not found "
            "(check: grep -l ENEK5130 /sys/class/hidraw/*/device/uevent)")
    try:
        return open(dev, "rb+", buffering=0)
    except PermissionError:
        die(f"no access to {dev} — udev rule missing? (or run with sudo)")


def send(fd, mask, r, g, b, bri=100, mode=0x02, speed=0, direction=0):
    pkt = bytearray([0xA4, 0x21, mode, bri, speed, direction, r, g, b, mask, 0])
    fcntl.ioctl(fd, HIDIOCSFEATURE_11, pkt)


def parse_hex(s):
    s = s.lstrip("#")
    if not re.fullmatch(r"[0-9a-fA-F]{6}", s):
        die(f"bad color {s!r} (want RRGGBB)")
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))


def is_hexish(s):
    return re.fullmatch(r"#?[0-9a-fA-F]{6}", s) is not None


def hsv(h, s=1.0, v=1.0):
    import colorsys
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, s, v)
    return int(r * 255), int(g * 255), int(b * 255)


def dim(rgb, f):
    f = max(0.0, min(1.0, f))
    return tuple(int(c * f) for c in rgb)


def is_colorful(rgb):
    return max(rgb) - min(rgb) >= 40


def theme_colors():
    """Pick 4 accent colors from the active omarchy theme."""
    order = ["accent", "color4", "color1", "color5", "color2", "color3",
             "color6", "color9", "color10", "color11", "color12", "color13"]
    toml_path = os.path.join(THEME, "colors.toml")
    alac_path = os.path.join(THEME, "alacritty.toml")
    raw = {}
    if os.path.exists(toml_path):
        import tomllib
        with open(toml_path, "rb") as f:
            data = tomllib.load(f)
        raw = {k: v for k, v in data.items() if isinstance(v, str)}
    elif os.path.exists(alac_path):
        txt = open(alac_path).read()
        for i, key in enumerate(["blue", "red", "magenta", "green",
                                 "yellow", "cyan"], start=1):
            m = re.search(rf'^{key}\s*=\s*["\']#?([0-9a-fA-F]{{6}})',
                          txt, re.M)
            if m:
                raw[f"color{i}"] = m.group(1)
        order = [f"color{i}" for i in range(1, 7)]
    else:
        die(f"no colors.toml or alacritty.toml in {THEME}")

    def add():
        for k in order:
            v = raw.get(k, "").lstrip("#")
            if re.fullmatch(r"[0-9a-fA-F]{6}", v or ""):
                yield parse_hex(v)

    found = []
    for c in add():
        if is_colorful(c) and c not in found:
            found.append(c)
    if len(found) < 4:
        for c in add():
            if c not in found:
                found.append(c)
    if not found:
        die("no usable colors in theme")
    while len(found) < 4:
        found.append(found[-1])
    return found[:4]


def stop_fx():
    try:
        pid = int(open(PIDFILE).read())
        # only kill if that pid is actually a kbrgb process (stale-pid safety)
        if b"kbrgb" in open(f"/proc/{pid}/cmdline", "rb").read():
            os.kill(pid, signal.SIGTERM)
            time.sleep(0.05)
    except (OSError, ValueError):
        pass
    try:
        os.remove(PIDFILE)
    except OSError:
        pass


def daemonize():
    if os.fork() > 0:
        os._exit(0)
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    null = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(null, fd)
    os.makedirs(os.path.dirname(PIDFILE), exist_ok=True)
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))


# ---------------------------------------------------------------- effects

def fx_breathe(t, p, cols, st):
    f = (1 - math.cos(2 * math.pi * t / p)) / 2
    return [dim(cols[0], f)] * 4


def fx_rainbow(t, p, cols, st):
    return [hsv(t / p)] * 4


def fx_wave(t, p, cols, st):
    return [hsv(t / p + i / 4) for i in range(4)]


def fx_snake(t, p, cols, st):
    """Bright head ping-pongs across zones, dimming tail behind it."""
    x = (2 * t / p) % 2.0
    pos = 3 * x if x < 1 else 3 * (2 - x)
    out = []
    for i in range(4):
        inten = max(0.0, 1.0 - abs(i - pos)) ** 1.6
        out.append(dim(cols[0], inten))
    return out


def fx_meteor(t, p, cols, st):
    """Comet moving one direction, tail wraps around."""
    pos = (4 * t / p) % 4.0
    out = []
    for i in range(4):
        dist = (pos - i) % 4.0
        out.append(dim(cols[0], max(0.0, 1.0 - dist / 2.6) ** 1.4))
    return out


def fx_police(t, p, cols, st):
    """Zones 1+3 flash color A, zones 2+4 flash color B, alternating."""
    a = cols[0] if cols else (255, 0, 0)
    b = cols[1] if len(cols) > 1 else (0, 51, 255)
    ph = int((2 * t / p) % 2)
    off = (0, 0, 0)
    return [a if ph == 0 else off, off if ph == 0 else b,
            a if ph == 0 else off, off if ph == 0 else b]


def fx_sparkle(t, p, cols, st):
    """Random zones ignite and fade; others stay dark."""
    lev = st.setdefault("lev", [0.0] * 4)
    col = st.setdefault("col", [cols[0]] * 4)
    for i in range(4):
        lev[i] *= 0.80
    if random.random() < 0.35:
        i = random.randrange(4)
        lev[i] = 1.0
        col[i] = random.choice(cols)
    return [dim(col[i], lev[i]) for i in range(4)]


def fx_fire(t, p, cols, st):
    """Flickering embers, warm gradient per zone."""
    v = st.setdefault("v", [random.uniform(0.5, 1.0) for _ in range(4)])
    out = []
    for i in range(4):
        v[i] = max(0.30, min(1.0, v[i] + random.uniform(-0.22, 0.22)))
        out.append((int(255 * v[i]), int(115 * v[i] ** 1.8),
                    int(10 * v[i] ** 3)))
    return out


def fx_heartbeat(t, p, cols, st):
    """Lub-dub double pulse, then rest."""
    x = (t % p) / p
    env = (math.exp(-((x - 0.10) / 0.045) ** 2)
           + 0.62 * math.exp(-((x - 0.30) / 0.055) ** 2) + 0.03)
    return [dim(cols[0], min(1.0, env))] * 4


def fx_aurora(t, p, cols, st):
    """Northern lights: greens through purples, slowly drifting per zone."""
    out = []
    for i in range(4):
        hue = 0.45 + 0.25 * math.sin(2 * math.pi * (t / p + i * 0.13))
        val = 0.55 + 0.45 * math.sin(2 * math.pi * (t / (p * 0.7) + i * 0.31))
        out.append(hsv(hue, 0.85, 0.35 + 0.65 * max(0.0, val)))
    return out


def fx_ocean(t, p, cols, st):
    """Blue swells rolling across the zones."""
    out = []
    for i in range(4):
        swell = max(0.0, math.sin(2 * math.pi * (t / p - i / 4))) ** 1.5
        hue = 0.52 + 0.06 * math.sin(2 * math.pi * (t / (p * 3) + i / 7))
        out.append(hsv(hue, 1.0, 0.15 + 0.85 * swell))
    return out


def fx_lava(t, p, cols, st):
    """Slow oozing magma: deep reds wandering into orange."""
    v = st.setdefault("v", [random.uniform(0.4, 0.9) for _ in range(4)])
    out = []
    for i in range(4):
        v[i] = max(0.25, min(1.0, v[i] + random.uniform(-0.06, 0.06)))
        out.append((int(255 * v[i]), int(60 * v[i] ** 2.2), 0))
    return out


def fx_matrix(t, p, cols, st):
    """Digital rain: dim green field, bright drops decaying."""
    lev = st.setdefault("lev", [0.0] * 4)
    for i in range(4):
        lev[i] *= 0.72
    if random.random() < 0.30:
        lev[random.randrange(4)] = 1.0
    return [(0, int(45 + 210 * lev[i]), int(20 * lev[i])) for i in range(4)]


def fx_candle(t, p, cols, st):
    """Cozy warm flicker, subtler and slower than fire."""
    v = st.setdefault("v", [0.76] * 4)
    out = []
    for i in range(4):
        # small random step + pull back toward the resting level, so the
        # flame drifts instead of strobing (issue #2 reported it as a flash)
        v[i] += random.uniform(-0.025, 0.025) + 0.06 * (0.76 - v[i])
        v[i] = max(0.62, min(0.90, v[i]))
        out.append(dim((255, 150, 30), v[i]))
    return out


def fx_storm(t, p, cols, st):
    """Dark night sky, random lightning strikes."""
    lev = st.setdefault("lev", [0.0] * 4)
    for i in range(4):
        lev[i] *= 0.55
    if random.random() < 0.035:
        strike = random.sample(range(4), random.choice((1, 2, 4)))
        for i in strike:
            lev[i] = 1.0
    base = (2, 5, 22)
    return [tuple(min(255, int(b + (f - b) * lev[i]))
                  for b, f in zip(base, (225, 235, 255))) for i in range(4)]


def fx_disco(t, p, cols, st):
    """Hard cuts on the beat: random zones, random vivid colors."""
    beat = int(t / p)
    if st.get("beat") != beat:
        st["beat"] = beat
        st["frame"] = [hsv(random.random()) if random.random() < 0.6
                       else (0, 0, 0) for _ in range(4)]
        if all(c == (0, 0, 0) for c in st["frame"]):
            st["frame"][random.randrange(4)] = hsv(random.random())
    return st["frame"]


def fx_duel(t, p, cols, st):
    """Two comets from opposite ends, additive blend where they cross."""
    x = (2 * t / p) % 2.0
    pos_a = 3 * x if x < 1 else 3 * (2 - x)
    pos_b = 3 - pos_a
    a, b = cols[0], cols[1] if len(cols) > 1 else cols[0]
    out = []
    for i in range(4):
        ia = max(0.0, 1.0 - abs(i - pos_a)) ** 1.6
        ib = max(0.0, 1.0 - abs(i - pos_b)) ** 1.6
        out.append(tuple(min(255, int(ca * ia + cb * ib))
                         for ca, cb in zip(a, b)))
    return out


def fx_shadow(t, p, cols, st):
    """Inverse snake: lit field with a roaming dark gap."""
    x = (2 * t / p) % 2.0
    pos = 3 * x if x < 1 else 3 * (2 - x)
    return [dim(cols[0], min(1.0, (abs(i - pos) / 1.2) ** 1.3))
            for i in range(4)]


def fx_ripple(t, p, cols, st):
    """Breathing that flows through the zones with a phase lag."""
    return [dim(cols[0], (1 - math.cos(2 * math.pi * (t / p - i * 0.18))) / 2)
            for i in range(4)]


def fx_chase(t, p, cols, st):
    """Marquee: one zone hard-on at a time."""
    idx = int(4 * t / p) % 4
    return [cols[0] if i == idx else dim(cols[0], 0.04) for i in range(4)]


def fx_strobe(t, p, cols, st):
    on = int(2 * t / p) % 2 == 0
    return [cols[0] if on else (0, 0, 0)] * 4


def _cpu_temp(st):
    now = time.monotonic()
    if now - st.get("t_read", 0) > 2.0:
        st["t_read"] = now
        best = None
        for hw in glob.glob("/sys/class/hwmon/hwmon*"):
            try:
                name = open(hw + "/name").read().strip()
                temps = [int(open(f).read()) / 1000
                         for f in glob.glob(hw + "/temp*_input")]
                if not temps:
                    continue
                if name == "coretemp" or best is None:
                    best = max(temps)
            except (OSError, ValueError):
                continue
        st["temp"] = best if best is not None else 60.0
    return st["temp"]


def _cpu_busy(st):
    """Aggregate CPU busy %, /proc/stat delta, cached 1 s."""
    now = time.monotonic()
    if now - st.get("c_read", 0) > 1.0:
        st["c_read"] = now
        try:
            parts = [int(x) for x in
                     open("/proc/stat").readline().split()[1:]]
            idle, total = parts[3] + parts[4], sum(parts)
            p_idle, p_total = st.get("c_prev", (idle, total))
            st["c_prev"] = (idle, total)
            d_total = total - p_total
            if d_total > 0:
                st["cpu"] = 100.0 * (1 - (idle - p_idle) / d_total)
        except (OSError, ValueError, IndexError):
            pass
    return st.get("cpu", 0.0)


def _gpu_busy(st):
    """NVIDIA dGPU busy %. A suspended card reads 0 and is left asleep —
    querying nvidia-smi while it's in D3cold can hang in the kernel."""
    now = time.monotonic()
    if now - st.get("g_read", 0) < 5.0:
        return st.get("gpu", 0.0)
    import subprocess
    st["g_read"] = now
    st["gpu"] = 0.0
    try:
        for dev in glob.glob("/sys/bus/pci/devices/*"):
            if open(dev + "/vendor").read().strip() != "0x10de":
                continue
            if not open(dev + "/class").read().startswith("0x03"):
                continue
            if open(dev + "/power/runtime_status").read().strip() != "active":
                return 0.0
            break
        else:
            return 0.0
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, timeout=1, text=True)
        st["gpu"] = float(out.stdout.strip().splitlines()[0])
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
        pass
    return st["gpu"]


def fx_load(t, p, cols, st):
    """CPU load fills the left pair of zones, GPU the right, green->red."""
    # measurements arrive ~1/s; glide the displayed value between them so
    # the bars sweep instead of stepping
    cpu = st["d_cpu"] = st.get("d_cpu", 0.0) * 0.88 + _cpu_busy(st) * 0.12
    gpu = st["d_gpu"] = st.get("d_gpu", 0.0) * 0.88 + _gpu_busy(st) * 0.12
    out = []
    for load, zones in ((cpu, (0, 1)), (gpu, (3, 2))):
        color = hsv(0.33 * (1.0 - load / 100.0))
        fills = (min(1.0, load / 50.0) ** 0.5,
                 max(0.0, (load - 50.0) / 50.0) ** 0.5)
        for zone, fill in zip(zones, fills):
            out.append((zone, dim(color, 0.15 + 0.85 * fill)))
    return [c for _, c in sorted(out)]


def fx_cpuheat(t, p, cols, st):
    """CPU temp gauge: 45C green -> 90C red, gentle pulse for life."""
    temp = _cpu_temp(st)
    frac = max(0.0, min(1.0, (temp - 45.0) / 45.0))
    pulse = 0.88 + 0.12 * math.sin(2 * math.pi * t / p)
    return [dim(hsv(0.33 * (1 - frac)), pulse)] * 4


def fx_battery(t, p, cols, st):
    """Four zones = four charge quarters; breathes while charging."""
    now = time.monotonic()
    if now - st.get("t_read", 0) > 5.0:
        st["t_read"] = now
        try:
            bat = glob.glob("/sys/class/power_supply/BAT*")[0]
            st["cap"] = int(open(bat + "/capacity").read())
            st["chg"] = open(bat + "/status").read().strip() == "Charging"
        except (IndexError, OSError, ValueError):
            st["cap"], st["chg"] = 100, False
    cap, chg = st["cap"], st["chg"]
    color = hsv(0.33 * cap / 100)
    breath = ((1 - math.cos(2 * math.pi * t / p)) / 2) if chg else 1.0
    out = []
    for i in range(4):
        fill = max(0.0, min(1.0, (cap - i * 25) / 25))
        out.append(dim(color, fill * (0.35 + 0.65 * breath)))
    return out


def fx_prism(t, p, cols, st):
    """Ripple whose hue advances one step per sweep — the color switch
    happens at each zone's dark trough, so every bloom arrives in the
    next tone. Progressive spectrum, seamless forever."""
    out = []
    for i in range(4):
        ph = t / p - i * 0.18
        cycle = math.floor(ph)
        inten = (1 - math.cos(2 * math.pi * ph)) / 2
        out.append(dim(hsv((cycle * 0.14) % 1.0), inten))
    return out


def fx_glitch(t, p, cols, st):
    """Rock-steady base color, randomly seized by malfunction bursts."""
    base = cols[0]
    wrong = [(255, 0, 144), (255, 255, 255), (0, 255, 65),
             (0, 234, 255), (0, 0, 0)]
    n = st.get("burst", 0)
    if n > 0:
        st["burst"] = n - 1
        return [random.choice(wrong) if random.random() < 0.7 else base
                for _ in range(4)]
    if random.random() < 0.04:
        st["burst"] = random.randint(2, 7)
    return [base] * 4


def fx_eruption(t, p, cols, st):
    """Dim smoldering magma; occasionally the whole thing blows."""
    v = st.setdefault("v", [0.25] * 4)
    e = st.get("e", 0.0) * 0.93
    if random.random() < 0.015:
        e = 1.0
    st["e"] = e
    out = []
    for i in range(4):
        v[i] = max(0.12, min(0.40, v[i] + random.uniform(-0.05, 0.05)))
        flare = e * random.uniform(0.75, 1.0)
        r = min(1.0, v[i] + flare)
        out.append((int(255 * r), int(40 * v[i] + 160 * flare ** 1.5),
                    int(190 * flare ** 3)))
    return out


def fx_redalert(t, p, cols, st):
    """Klaxon: tense ramp up, hold, hard cut. Repeat until crisis over."""
    x = (t % p) / p
    if x < 0.55:
        env = (x / 0.55) ** 2
    elif x < 0.72:
        env = 1.0
    else:
        env = max(0.06, 1.0 - (x - 0.72) / 0.10)
    return [dim(cols[0], env)] * 4


def fx_supernova(t, p, cols, st):
    """Charge-up in the core, detonation front, orange afterglow."""
    x = (t % p) / p
    out = []
    for i in range(4):
        d = abs(i - 1.5)          # distance from keyboard center
        if x < 0.60:              # charging: core brightens blue-white
            f = (x / 0.60) ** 2 * max(0.15, 1.0 - d * 0.55)
            out.append(dim((170, 200, 255), f))
        elif x < 0.75:            # detonation front races outward
            front = (x - 0.60) / 0.15 * 2.4
            f = math.exp(-((d - front) * 2.0) ** 2)
            out.append(dim((255, 255, 255), f))
        else:                     # embers fade
            f = max(0.0, 1.0 - (x - 0.75) / 0.25) ** 2 * (1.0 - d * 0.25)
            out.append(dim((255, 120, 20), f))
    return out


def fx_shockwave(t, p, cols, st):
    """Silence, then a bright front slams across the board."""
    x = (t % p) / p
    if x >= 0.30:
        return [dim(cols[0], 0.05)] * 4
    pos = x / 0.30 * 4.6 - 0.8
    return [dim(cols[0], min(1.0, 0.05 + math.exp(-((i - pos) * 1.8) ** 2)))
            for i in range(4)]


def fx_typewriter(t, p, cols, st):
    """Whole board glows brighter with every keystroke, decays back."""
    env = st.get("env", 0.0) * 0.90
    env = min(1.0, env + 0.35 * len(st.get("new", ())))
    st["env"] = env
    return [dim(cols[0], 0.25 + 0.75 * env)] * 4


# QWERTY split into the four lighting zones by physical column. Keys not
# listed (media keys etc.) light the whole board softly instead.
KEYZONE = {code: zone for zone, codes in enumerate((
    (1, 41, 15, 58, 42, 29, 2, 16, 30, 44, 3, 17, 31, 45, 125),      # esc..x
    (4, 5, 6, 18, 19, 20, 32, 33, 34, 46, 47, 48, 56, 57),           # 3..b,space
    (7, 8, 9, 21, 22, 23, 35, 36, 37, 49, 50, 51, 100),              # 6..comma
    (10, 11, 12, 13, 14, 24, 25, 26, 27, 28, 38, 39, 40, 43, 52,
     53, 54, 97, 103, 105, 106, 108, 102, 104, 107, 109, 110, 111),  # 9..arrows
)) for code in codes}


def fx_keyflash(t, p, cols, st):
    """The zone under each keystroke flashes and spills on its neighbors."""
    z = st.setdefault("z", [0.0] * 4)
    for i in range(4):
        z[i] *= 0.82
    for _, code in st.get("new", ()):
        zone = KEYZONE.get(code)
        if zone is None:
            for i in range(4):
                z[i] = max(z[i], 0.30)
            continue
        z[zone] = 1.0
        for n in (zone - 1, zone + 1):
            if 0 <= n < 4:
                z[n] = max(z[n], 0.40)
    return [dim(cols[0], 0.15 + 0.85 * z[i]) for i in range(4)]


def _typing_heat(st):
    """(hue_frac, brightness_frac) from typing speed. Red is reached at
    FX_OPT["wpm"] (default 96); WPM/12 = keys per second."""
    now = st.get("now", 0.0)
    kps = sum(1 for ts, _ in st.get("keys", ()) if now - ts < 3.0) / 3.0
    ema = st["ema"] = 0.85 * st.get("ema", 0.0) + 0.15 * kps
    kmax = FX_OPT.get("wpm", 96.0) / 12.0
    return min(1.0, ema / kmax), min(1.0, ema / (kmax / 2.0))


def fx_wpmheat(t, p, cols, st):
    """Typing speed as heat: idle blue, red at your ceiling WPM."""
    frac, drive = _typing_heat(st)
    return [dim(hsv(0.60 * (1.0 - frac)), 0.30 + 0.70 * drive)] * 4


def _idle_env(st, p):
    """Sleep/wake envelope: holds 1.0 while keys arrive, fades to 0 over
    ~2 s once p seconds pass without one, snaps back up on the next key."""
    now = st.get("now", 0.0)
    if "t0" not in st:
        st["t0"] = now
    idle = now - st.get("last_key", st["t0"])
    env = st.get("env", 1.0)
    env = min(1.0, env + 0.5) if idle < p else max(0.0, env - 0.03)
    st["env"] = env
    return env


def fx_flow(t, p, cols, st):
    """wpmheat and zen in one: color tracks typing speed, and the board
    falls asleep after p idle seconds (default 30) like zen does."""
    frac, drive = _typing_heat(st)
    return [dim(hsv(0.60 * (1.0 - frac)),
                (0.30 + 0.70 * drive) * _idle_env(st, p))] * 4


def fx_zen(t, p, cols, st):
    """Static color that sleeps when you do: fades out after p idle
    seconds (default 30, set with -s), any key wakes it instantly."""
    return [dim(cols[0], _idle_env(st, p))] * 4


# hour-of-day anchors: (hour, hue, saturation, value)
CLOCK_STOPS = [(0, 0.62, 0.90, 0.25), (5, 0.62, 0.90, 0.30),
               (6.5, 0.06, 1.00, 0.80), (8, 0.10, 0.60, 0.90),
               (12, 0.12, 0.40, 1.00), (17, 0.09, 0.80, 0.95),
               (20, 0.78, 0.70, 0.60), (22, 0.66, 0.90, 0.35),
               (24, 0.62, 0.90, 0.25)]


def fx_clock(t, p, cols, st):
    """Ambient hue that follows the time of day."""
    lt = time.localtime()
    h = lt.tm_hour + lt.tm_min / 60.0
    for (h0, *a), (h1, *b) in zip(CLOCK_STOPS, CLOCK_STOPS[1:]):
        if h0 <= h <= h1:
            f = (h - h0) / (h1 - h0)
            hue, sat, val = (x + f * (y - x) for x, y in zip(a, b))
            break
    breathe = 1.0 + 0.08 * math.sin(2 * math.pi * t / 8.0)
    return [dim(hsv(hue, sat, val), min(1.0, breathe))] * 4


def _net_rates(st):
    """(rx, tx) bytes/s across non-lo interfaces, cached 0.5 s."""
    now = time.monotonic()
    if now - st.get("n_read", 0) > 0.5:
        rx = tx = 0
        try:
            for line in open("/proc/net/dev").readlines()[2:]:
                name, data = line.split(":", 1)
                if name.strip() == "lo":
                    continue
                f = data.split()
                rx += int(f[0]); tx += int(f[8])
        except (OSError, ValueError, IndexError):
            pass
        p_rx, p_tx, p_t = st.get("n_prev", (rx, tx, now))
        dt_ = max(1e-3, now - p_t)
        st["rates"] = ((rx - p_rx) / dt_, (tx - p_tx) / dt_)
        st["n_prev"] = (rx, tx, now)
        st["n_read"] = now
    return st.get("rates", (0.0, 0.0))


def fx_netpulse(t, p, cols, st):
    """Download flows cyan right-to-left, upload orange left-to-right."""
    rx, tx = _net_rates(st)
    lvl = lambda r: min(1.0, math.log10(1 + r) / 8.0)   # 100 MB/s = max
    rxl, txl = lvl(rx), lvl(tx)
    st["ph"] = st.get("ph", 0.0) + 0.05 * (0.3 + 3.0 * max(rxl, txl))
    out = []
    for i in range(4):
        wr = 0.5 + 0.5 * math.sin(2 * math.pi * (i / 4.0 + st["ph"]))
        wt = 0.5 + 0.5 * math.sin(2 * math.pi * (i / 4.0 - st["ph"]))
        r = min(255, int(6 + 255 * txl * wt))
        gch = min(255, int(6 + 140 * txl * wt + 200 * rxl * wr))
        b = min(255, int(10 + 255 * rxl * wr))
        out.append((r, gch, b))
    return out


def fx_pomo(t, p, cols, st):
    """Pomodoro: zones drain as quarters of the timer, green->red;
    triple white flash at zero, then holds dim red until stopped."""
    rem = p - t
    if rem <= 0:
        fl = -rem
        if fl < 1.8 and (fl % 0.6) < 0.3:
            return [(255, 255, 255)] * 4
        return [dim((255, 0, 0), 0.25)] * 4
    frac = 1.0 - rem / p                        # elapsed fraction
    color = hsv(0.33 * (1.0 - frac))
    pulse = (0.55 + 0.45 * math.sin(2 * math.pi * t * 2.0)) if rem < 10 else 1.0
    q = p / 4.0
    return [dim(color, pulse * max(0.04, min(1.0, (rem - i * q) / q)))
            for i in range(4)]


FX_FUNCS = {
