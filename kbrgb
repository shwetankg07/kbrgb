FALLBACK_COLORS = [(255, 42, 42), (0, 234, 255), (255, 179, 0), (0, 255, 65)]


def theme_or_default():
    try:
        return theme_colors()
    except SystemExit:
        return FALLBACK_COLORS


def preset_args(name):
    """Look up a preset by (case-insensitive) name, return its args or None."""
    conf = os.path.expanduser("~/.config/kbrgb/presets.conf")
    try:
        lines = open(conf).read().splitlines()
    except OSError:
        return None
    for line in lines:
        if "=" not in line or line.lstrip().startswith("#"):
            continue
        k, v = line.split("=", 1)
        if k.strip().lower() == name.lower():
            return v.split()
    return None


def cmd_status():
    path = find_dev()
    print(f"device:  {path or 'NOT FOUND'}")
    try:
        print(f"saved:   {open(STATE).read()}")
    except OSError:
        print("saved:   (nothing)")
    try:
        pid = int(open(PIDFILE).read())
        alive = os.path.exists(f"/proc/{pid}")
        print(f"daemon:  pid {pid} ({'running' if alive else 'dead, stale pidfile'})")
    except (OSError, ValueError):
        print("daemon:  not running")


def cmd_demo():
    stop_fx()
    print("touring all effects, ~4s each — Ctrl-C to stop\n")
    try:
        with open_dev() as dev:
            fd = dev.fileno()
            for name in FX_FUNCS:
                print(f"  {name}", flush=True)
                p, _, dt = EFFECTS[name]
                cols = DEFAULT_COLORS.get(name) or theme_or_default()
                st = {}
                t0 = time.monotonic()
                while time.monotonic() - t0 < 4.0:
                    zones = FX_FUNCS[name](time.monotonic() - t0, p, cols, st)
                    for mask, (r, g, b) in zip(ZONES, zones):
                        send(fd, mask, r, g, b)
                    time.sleep(dt)
    except KeyboardInterrupt:
        print()
    print("\ndemo over — apply one with: kbrgb <effect>")


def cmd_probe():
    """Guided diagnostic for testing new hardware. Produces a paste-ready
    report for a GitHub issue."""
    stop_fx()
    path = find_dev()
    if path is None:
        print("RESULT: no ENEK5130 device — this tool does not apply to "
              "your machine as-is.\nDevices present:")
        for p in glob.glob("/sys/class/hidraw/hidraw*"):
            uev = dict(l.split("=", 1) for l in
                       open(p + "/device/uevent").read().splitlines())
            print(f"  {p}: {uev.get('HID_NAME', '?')}")
        sys.exit(1)

    answers = []

    def step(desc, fn):
        fn()
        ans = input(f"[{len(answers) + 1}] {desc}\n    what you see> ").strip()
        answers.append((desc, ans))

    print(f"kbrgb hardware probe — device {path}")
    print("answer each question with what your keyboard actually shows.\n")
    try:
        with open(path, "rb+", buffering=0) as f:
            fd = f.fileno()

            def dark():
                for m in ZONES:
                    send(fd, m, 0, 0, 0)

            dark()
            step("zone 1 (leftmost) RED only?",
                 lambda: send(fd, 0x01, 255, 0, 0))
            step("zone 2 GREEN added?", lambda: send(fd, 0x02, 0, 255, 0))
            step("zone 3 BLUE added?", lambda: send(fd, 0x04, 0, 0, 255))
            step("zone 4 (rightmost) WHITE added?",
                 lambda: send(fd, 0x08, 255, 255, 255))

            def all_mask():
                dark()
                send(fd, 0x0F, 255, 0, 255)
            step("mask 0x0f: ALL zones magenta? full brightness or dim?",
                 all_mask)

            def red15():
                for m in ZONES:
                    send(fd, m, 255, 0, 0, 15)
            step("red at brightness byte 15 — how bright?", red15)

            def red100():
                for m in ZONES:
                    send(fd, m, 255, 0, 0, 100)
            step("red at brightness byte 100 — brighter than before?", red100)

            def burst():
                t0 = time.monotonic()
                while time.monotonic() - t0 < 3.0:
                    t = time.monotonic() - t0
                    for i, m in enumerate(ZONES):
                        send(fd, m, *hsv(t / 2 + i / 4))
                    time.sleep(0.05)
            step("3s animation burst — smooth, or flicker/stalls?", burst)
            dark()
    except KeyboardInterrupt:
        print("\nprobe aborted")
        sys.exit(1)

    model = "?"
    try:
        model = open("/sys/class/dmi/id/product_name").read().strip()
    except OSError:
        pass
    print("\n--- copy everything below into a GitHub issue ---")
    print(f"Model: {model}")
    print(f"Device: {path}")
    for desc, ans in answers:
        print(f"- {desc} -> {ans}")


# ---------------------------------------------------------------- main

def main():
    args = sys.argv[1:]
    restoring = args == ["restore"]
    if restoring:
        try:
            args = open(STATE).read().split()
        except OSError:
            die("nothing saved to restore")

    brightness, period = 100, None
    for flag in ("-b", "-s"):
        while flag in args:  # last occurrence wins (preset + user override)
            i = args.index(flag)
            try:
                val = float(args[i + 1])
            except (IndexError, ValueError):
                die(f"{flag} needs a number")
            if flag == "-b":
                brightness = int(val)
            else:
                period = val
            del args[i:i + 2]

    reverse = False
    while "-r" in args:
        args.remove("-r")
        reverse = True

    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return

    if args == ["list"]:
        print("\n".join(EFFECTS))
        return
    if args == ["status"]:
        cmd_status()
        return
    if args == ["demo"]:
        cmd_demo()
        return
    if args == ["probe"]:
        cmd_probe()
        return

    def save():
        if restoring:
            return
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        extra = (["-s", str(period)] if period else []) \
            + (["-r"] if reverse else [])
        with open(STATE, "w") as st:
            st.write(" ".join(["-b", str(brightness)] + extra + args))

    # --- EC-native effects (single write, hardware animates) ---
    if args[0] == "native":
        rest = args[1:]
        if not rest or rest[0] in ("list", "-h", "--help"):
            for name, (byte, uses_color) in NATIVE.items():
                tag = "[C]" if uses_color else "   (color ignored)"
                print(f"{name:8} 0x{byte:02x} {tag}")
            return
        name = rest[0]
        if name not in NATIVE:
            die(f"unknown native effect {name!r} (see: kbrgb native list)")
        if len(rest) > 2 or (len(rest) == 2 and not is_hexish(rest[1])):
            die(f"native {name} takes one optional hex color")
        mode, uses_color = NATIVE[name]
        if len(rest) == 2:
            color = parse_hex(rest[1])
        else:
            color = theme_or_default()[0] if uses_color else (255, 0, 0)
        speed = 5 if period is None else int(period)
        if not 0 <= speed <= 10:
            die("for native effects -s is the EC speed byte, 0-10")
        stop_fx()
        with open_dev() as f:
            send(f.fileno(), ZONE_ALL, *color, max(1, min(100, brightness)),
                 mode=mode, speed=speed, direction=2 if reverse else 1)
        save()
        return

    # --- animated effects (daemonized) ---
    if args[0] in EFFECTS:
        effect, rest = args[0], args[1:]
        d_period, max_cols, _ = EFFECTS[effect]
        if effect == "pomo":
            # kbrgb pomo 25 = 25 minutes; the EFFECTS default is minutes too
            d_period *= 60.0
            if rest and re.fullmatch(r"\d+(\.\d+)?", rest[0]):
                period = period or float(rest[0]) * 60.0
                rest = rest[1:]
        if effect in ("wpmheat", "flow") \
                and rest and re.fullmatch(r"\d+(\.\d+)?", rest[0]):
            # kbrgb wpmheat 80 = full red at 80 WPM (default 96)
            FX_OPT["wpm"] = max(12.0, float(rest[0]))
            rest = rest[1:]
        if len(rest) > max_cols or not all(is_hexish(a) for a in rest):
            die(f"{effect} takes up to {max_cols} hex color(s)")
        colors = [parse_hex(a) for a in rest]
        if not colors:
            colors = DEFAULT_COLORS.get(effect) or theme_or_default()
        period = period or d_period
        if effect in REACTIVE:
            probe = open_keyboards()
            if not probe:
                die("reactive effects need read access to /dev/input — "
                    "add yourself to the input group: "
                    "sudo usermod -aG input $USER (then log out and back in)")
            for fd in probe:
                os.close(fd)
        stop_fx()
        save()
        run_effect(effect, colors, period, brightness)
        return  # unreachable (daemon loops)

    # --- static modes ---
    if args == ["off"]:
        colors = [(0, 0, 0)] * 4
        brightness = 1
    elif args == ["theme"]:
        colors = theme_colors()
    elif len(args) == 1 and is_hexish(args[0]):
        colors = [parse_hex(args[0])] * 4
    elif len(args) == 4 and all(is_hexish(a) for a in args):
        colors = [parse_hex(a) for a in args]
    else:
        # not a color or effect: try it as a preset name ("thunderstorm")
        pargs = preset_args(" ".join(args))
        if pargs is None:
            die("give colors, 'theme', an effect, a preset name, or 'off' "
                "(see --help)")
        extra = (["-b", str(brightness)] if brightness != 100 else []) \
            + (["-s", str(period)] if period else []) \
            + (["-r"] if reverse else [])
        sys.argv = [sys.argv[0]] + pargs + extra
        return main()

    stop_fx()
    bri = max(1, min(100, brightness))
    with open_dev() as f:
        if colors.count(colors[0]) == 4:
            send(f.fileno(), ZONE_ALL, *colors[0], bri)
        else:
            for mask, (r, g, b) in zip(ZONES, colors):
                send(f.fileno(), mask, r, g, b, bri)
    save()


if __name__ == "__main__":
    main()
