    "ripple": fx_ripple, "chase": fx_chase, "strobe": fx_strobe,
    "cpuheat": fx_cpuheat, "battery": fx_battery, "prism": fx_prism,
    "glitch": fx_glitch, "eruption": fx_eruption, "redalert": fx_redalert,
