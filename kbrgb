}


def run_effect(effect, colors, period, bright):
    daemonize()
    bmax = max(1, min(100, bright))
    fn = FX_FUNCS[effect]
    dt = EFFECTS[effect][2]
    st = {}
    dev = None
    kbs = open_keyboards() if effect in REACTIVE else {}
    t0 = time.monotonic()
    while True:
        try:
            if effect in REACTIVE:
                drain_keys(kbs, st)
            if dev is None:
                path = find_dev()
                if path is None:
                    raise OSError("device absent")
                dev = open(path, "rb+", buffering=0)
            zones = fn(time.monotonic() - t0, period, colors, st)
            if zones.count(zones[0]) == 4:
                # uniform frame: one 0x0f write instead of four
                send(dev.fileno(), ZONE_ALL, *zones[0], bmax)
            else:
                for mask, (r, g, b) in zip(ZONES, zones):
                    send(dev.fileno(), mask, r, g, b, bmax)
            time.sleep(dt)
        except OSError:
            # device blipped (suspend/resume, i2c reset) — reopen and go on
            try:
                if dev:
                    dev.close()
            except OSError:
                pass
            dev = None
            time.sleep(2)


